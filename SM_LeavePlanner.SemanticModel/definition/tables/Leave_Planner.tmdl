table Leave_Planner
	lineageTag: a0cbe54d-084e-4bdc-b898-85089185cf17
	sourceLineageTag: [dbo].[Leave_Planner_120_Sample_Records]

	measure 'Total Leave Days' =
			
			SUM('leave_planner'[Duration Days])
		formatString: 0
		lineageTag: a944b680-a9e6-47d8-ba47-0bb384ce36ca

		changedProperty = Name

	measure 'Approved Leave Days' =
			
			CALCULATE(
			    SUM('leave_planner'[Duration Days]),
			    'leave_planner'[Status] = "Approved"
			)
		formatString: 0
		lineageTag: 559d8611-1746-4a0e-bd94-e8e5947f122b

		changedProperty = Name

	measure 'Pending Leave Requests' =
			
			CALCULATE(
			    COUNTROWS('leave_planner'),
			    'leave_planner'[Status] = "Pending"
			)
		formatString: 0
		lineageTag: 30d7db32-99f4-47ad-bc90-bfde69f029ae

		changedProperty = Name

	measure Employees =
			
			DISTINCTCOUNT('leave_planner'[Employee Name])
		formatString: 0
		lineageTag: a7f93960-21d6-4ff5-adaa-aefaf6a7f2b3

		changedProperty = Name

